#====================LR檢定====================
# 完整模型（stepAIC 選出的模型）
aft_full <- aft_weibull_step

# 去掉 Fatigue 的模型
aft_no_fatigue <- update(aft_full, . ~ . - Fatigue)

# 去掉 Shortness_of_Breath 的模型
aft_no_sob <- update(aft_full, . ~ . - Shortness_of_Breath)

# 去掉兩者的模型
aft_no_both <- update(aft_full, . ~ . - Fatigue - Shortness_of_Breath)

# LR 檢定：有無 Fatigue
lrtest(aft_full, aft_no_fatigue)

# LR 檢定：有無 Shortness_of_Breath
lrtest(aft_full, aft_no_sob)

# LR 檢定：同時去掉兩個
lrtest(aft_full, aft_no_both)
