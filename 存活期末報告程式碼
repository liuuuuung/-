#====================敘述統計量====================
#離散型變數(卡方檢定)
library(tidyverse)
library(gtsummary)
library(gt)
df <- df %>%
  mutate(
    Smoking_Status = factor(Smoking_Status,
                            levels = c("Never Smoked", "Former Smoker", "Current Smoker")),
    Air_Pollution_Exposure = factor(Air_Pollution_Exposure,
                                    levels = c("Low", "Moderate", "High")),
    Alcohol_Use = factor(Alcohol_Use,
                         levels = c("No Alcohol", "Moderate", "Heavy")),
    Exercise_Frequency = factor(Exercise_Frequency,
                                levels = c("Low", "Moderate", "High")),
    Cancer_Stage = factor(Cancer_Stage,
                          levels = c("Stage I", "Stage II", "Stage III", "Stage IV"))
  )

# 定義離散型變數清單
discrete_vars <- c(
  # 核心變數
  "Smoking_Status", "Cancer_Stage", "Treatment", "Survived",
  # 臨床背景
  "Gender", "Cancer_Type", "NSCLC_Subtype",
  "Chronic_Lung_Disease", "Previous_Cancer_History",
  # 症狀
  "Coughing", "Shortness_of_Breath", "Chest_Pain",
  "Coughing_Blood", "Fatigue",
  # 環境／生活型態
  "Secondhand_Smoke", "Occupational_Hazard",
  "Air_Pollution_Exposure", "Alcohol_Use",
  "Exercise_Frequency", "Family_History"
)

df %>%
  select(all_of(discrete_vars)) %>%
  tbl_summary(
    by = Survived,
    statistic = all_categorical() ~ "{n} ({p}%)",
    digits = all_categorical() ~ c(0, 1),
    missing = "no"
  ) %>%
  add_overall() %>%
  add_p() %>%          
  bold_labels() %>%
  bold_p(t = 0.05) %>%
  modify_caption("**表一：離散型變數依存活狀態分組比較**")

#====================連續長條圖====================
library(ggplot2)
library(patchwork)
n  <- nrow(df)

#(1)Age
bw_Age <- (max(df$Age) - min(df$Age)) / 30  
scale_factor_Age <- n * bw_Age                  

ggplot(df, aes(x = Age)) +
  geom_histogram(aes(y = after_stat(density) * scale_factor_Age),
                 bins = 30, fill = "tan1", color = "white") +
  stat_function(fun = function(x) dnorm(x, mean = mean(df$Age), sd = sd(df$Age)) * scale_factor_Age,
                color = "tomato", linewidth = 1) +
  scale_y_continuous(
    name = "Count",
    sec.axis = sec_axis(~ . / scale_factor_Age, name = "density")
  ) +
  labs(title = "年齡分佈", x = "Age") +
  theme_minimal(base_size = 13) +
  theme(plot.title = element_text(face = "bold", hjust = 0.5),
        axis.title.y.left  = element_text(color = "gray30"),
        axis.title.y.right = element_text(color = "gray30"))

