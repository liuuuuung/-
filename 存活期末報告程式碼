#====================熱圖====================
library(rcompanion)
library(ggplot2)
library(reshape2)
library(dplyr)

# 將連續型變數分組（三等分）
df_cat <- df %>%
  mutate(
    Age            = cut(Age, breaks = 3, labels = c("低", "中", "高")),
    BMI            = cut(BMI, breaks = 3, labels = c("低", "中", "高")),
    Tumor_Size_cm  = cut(Tumor_Size_cm, breaks = 3, labels = c("小", "中", "大")),
    Cigarettes_Per_Day = cut(Cigarettes_Per_Day, breaks = 3, labels = c("低", "中", "高")),
    Years_Smoking  = cut(Years_Smoking, breaks = 3, labels = c("短", "中", "長")),
    Survival_Months = cut(Survival_Months, breaks = 3, labels = c("短", "中", "長")))

all_vars <- c(
  "Age", "BMI", "Tumor_Size_cm", "Cigarettes_Per_Day", "Years_Smoking",
  "Gender", "Smoking_Status", "Cancer_Stage", "Treatment", "Cancer_Type",
  "NSCLC_Subtype", "Chronic_Lung_Disease", "Previous_Cancer_History",
  "Secondhand_Smoke", "Occupational_Hazard", "Air_Pollution_Exposure",
  "Alcohol_Use", "Exercise_Frequency", "Family_History",
  "Coughing", "Shortness_of_Breath", "Chest_Pain", "Coughing_Blood",
  "Fatigue", "Survived")

n <- length(all_vars)
cramer_matrix <- matrix(NA, n, n, dimnames = list(all_vars, all_vars))

for (i in 1:n) {
  for (j in 1:n) {
    if (i == j) {
      cramer_matrix[i, j] <- 1
    } else {
      tbl <- table(df_cat[[all_vars[i]]], df_cat[[all_vars[j]]])
      cramer_matrix[i, j] <- cramerV(tbl, bias.correct = TRUE)
    }
  }
}

cramer_df <- melt(cramer_matrix)
ggplot(cramer_df, aes(x = Var1, y = Var2, fill = value)) +
  geom_tile(color = "white") +
  geom_text(aes(label = round(value, 2)), size = 2.5, color = "gray20") +
  scale_fill_gradient(low = "white", high = "tomato",
                      limits = c(0, 1), name = "Cramér's V") +
  labs(title = "變數間相關性熱圖（Cramér's V）",
       x = NULL, y = NULL) +
  theme_minimal(base_size = 11) +
  theme(
    plot.title   = element_text(face = "bold", hjust = 0.5),
    axis.text.x  = element_text(angle = 45, hjust = 1, size = 8),
    axis.text.y  = element_text(size = 8))

#====================Cox Model====================
library(survival)
library(MASS)
library(dplyr)
n <- sum(length(df$Survived))

df <- df %>%
  mutate(
    # 建立數值型事件變數（1 = 死亡, 0 = 存活）
    event = ifelse(Survived == "Yes", 0, 1),
    
    # 設定 factor 順序
    Smoking_Status = factor(Smoking_Status,
                            levels = c("Never Smoked", "Former Smoker", "Current Smoker")),
    Cancer_Stage = factor(Cancer_Stage,
                          levels = c("Stage I", "Stage II", "Stage III", "Stage IV")),
    Air_Pollution_Exposure = factor(Air_Pollution_Exposure,
                                    levels = c("Low", "Moderate", "High")),
    Alcohol_Use = factor(Alcohol_Use,
                         levels = c("No Alcohol", "Moderate", "Heavy")),
    Exercise_Frequency = factor(Exercise_Frequency,
                                levels = c("Low", "Moderate", "High"))
  )


# Full Model Cox
full_cox <- coxph(
  Surv(Survival_Months, Survived == "No") ~
    Age + BMI + Tumor_Size_cm + Cigarettes_Per_Day + Years_Smoking + Smoking_Status +
    Cancer_Stage + Treatment + Cancer_Type + NSCLC_Subtype +
    Chronic_Lung_Disease + Previous_Cancer_History + Secondhand_Smoke +
    Occupational_Hazard + Air_Pollution_Exposure + Alcohol_Use +
    Exercise_Frequency + Family_History + Gender +
    Coughing + Shortness_of_Breath + Chest_Pain + Coughing_Blood + Fatigue,
  data = df)
summary(full_cox)

# Stepwise AIC 選模 
full_cox_step <- stepAIC(full_cox, direction = "both", trace = FALSE)
full_cox_stepB <- stepAIC(full_cox, direction = "both", trace = FALSE, k = log(n))
summary(full_cox_step)
summary(full_cox_stepB)

# PH 假設檢驗
ph_test_full <- cox.zph(full_cox_step)  
print(ph_test_full)
plot(ph_test_full)
ph_test_fullB <- cox.zph(full_cox_stepB) 
print(ph_test_fullB)

# (1) Stratified Cox 
cox_Stratified <- coxph(
  Surv(Survival_Months, Survived == "No") ~
    Age + BMI + Tumor_Size_cm + Cigarettes_Per_Day + Years_Smoking + Smoking_Status +
    Treatment + Cancer_Type + NSCLC_Subtype +
    Chronic_Lung_Disease + Previous_Cancer_History + Secondhand_Smoke +
    Occupational_Hazard + Air_Pollution_Exposure + Alcohol_Use +
    Exercise_Frequency + Family_History + Gender +
    Coughing + Shortness_of_Breath + Chest_Pain + Coughing_Blood + Fatigue +
    strata(Cancer_Stage),
  data = df)
summary(cox_Stratified)

#  Stepwise
cox_Stratified_step <- stepAIC(cox_Stratified, direction = "both", trace = FALSE)
summary(cox_Stratified_step)

# PH 假設檢驗
ph_test_Stratified <- cox.zph(cox_Stratified_step)  
print(ph_test_Stratified)
plot(ph_test_Stratified)

# (2) Partition Time Axis
# 切割時間軸
df_split <- survSplit(
  Surv(Survival_Months, Survived == "No") ~ .,
  data    = df,
  cut     = 13,
  episode = "time_period")

cox_partition <- coxph(
  Surv(tstart, Survival_Months, event) ~
    Cancer_Stage : strata(time_period) +
    Age + BMI + Tumor_Size_cm + Cigarettes_Per_Day + Years_Smoking +
